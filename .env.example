# ---------------------------------------------------------------------------
# Smart Energy AI - environment settings
#
# EVERY SETTING IN THIS FILE IS OPTIONAL.
# The application runs completely without it, in demo/offline mode, using the
# built-in rule engine for insights and local statistics for prediction and
# anomaly detection. No paid API is needed at any point.
#
# To use it:   cp .env.example .env     (Windows: copy .env.example .env)
# then edit .env. Never commit .env - it is already in .gitignore.
# ---------------------------------------------------------------------------

# Port the app listens on. Default 5000.
PORT=5000

# Set to 1 only while developing. Leave unset in normal use.
FLASK_DEBUG=0

# Set to 0 if you do not want a browser tab to open on startup.
OPEN_BROWSER=1


# ---------------------------------------------------------------------------
# OPTIONAL: AI narration
#
# Turning this on adds ONE thing: a short written summary on the AI Insights
# page and the ability to ask questions about your data. Every insight,
# forecast, anomaly and recommendation is generated locally either way.
#
# Pick ONE provider by uncommenting its AI_PROVIDER line.
# The key is read by the Python server only. It is never sent to the browser.
# ---------------------------------------------------------------------------

# --- Option 1: Ollama - free, runs on your own machine, no key, no internet --
# Install from https://ollama.com then run:  ollama pull llama3.2
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Option 2: any OpenAI-compatible endpoint (paid, or a local server) ------
# Works with OpenAI, Groq, Together, LM Studio, vLLM and similar.
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=paste-your-own-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Option 3: Anthropic (paid) ---------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=paste-your-own-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
